    <worksheet name='RPR KPI'>
      <layout-options>
        <title>
          <formatted-text />
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='FACT_ORDERS+ (Fleurop)' name='federated.1c8xuqf0g4u9991101pha17etbqa' />
            <datasource name='Parameters' />
          </datasources>
          <datasource-dependencies datasource='Parameters'>
            <column caption='Select Year' datatype='integer' default-format='n0;-0' name='[Parameter 1]' param-domain-type='list' role='measure' type='quantitative' value='2024'>
              <calculation class='tableau' formula='2024' />
            </column>
            <column caption='Target %' datatype='real' name='[Parameter 2]' param-domain-type='range' role='measure' type='quantitative' value='0.9'>
              <calculation class='tableau' formula='0.9' />
              <range max='1.0' />
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.1c8xuqf0g4u9991101pha17etbqa'>
            <column aggregation='CountD' datatype='string' name='[AgeGroup]' role='dimension' type='nominal' />
            <column caption='Converstion Rate' datatype='real' name='[Calculation_164662880779730944]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM( IIF([isConversion] = TRUE, 1, 0) )&#13;&#10; /&#13;&#10;COUNT([isConversion])' />
            </column>
            <column caption='OnTime Rate' datatype='real' name='[Calculation_164662880785309697]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='SUM( IIF([IsOnTime] = TRUE , 1 , 0) )&#13;&#10;/&#13;&#10;COUNT([IsOnTime])' />
            </column>
            <column caption='RPR Color' datatype='string' name='[Calculation_164662880789606404]' role='measure' type='nominal'>
              <calculation class='tableau' formula='IF [Calculation_910571568677040141] &gt;= [Parameters].[Parameter 2] THEN &quot;Good&quot; ELSE &quot;Bad&quot; END' />
            </column>
            <column caption='Year' datatype='boolean' name='[Calculation_164662880793395206]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='YEAR([OrderDate]) = [Parameters].[Parameter 1]' />
            </column>
            <column caption='Customers' datatype='integer' name='[Calculation_910571568643772417]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='count([Email (DIM_CUSTOMERS)])' />
            </column>
            <column caption='Average Rating' datatype='real' name='[Calculation_910571568646262786]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='AVG([Rating])' />
            </column>
            <column caption='RPR Total' datatype='real' datatype-customized='true' name='[Calculation_910571568677040141]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='COUNTD(&#13;&#10;  IF { FIXED [Email] : COUNT([OrderID]) } &gt; 1&#13;&#10;  THEN [Email]&#13;&#10;  END&#13;&#10;)&#13;&#10;/ &#13;&#10;COUNTD(&#13;&#10;  IF { FIXED [Email] : COUNT([OrderID]) } &gt;= 1&#13;&#10;  THEN [Email]&#13;&#10;  END&#13;&#10;)' />
            </column>
            <column datatype='string' name='[Category]' role='dimension' type='nominal' />
            <column caption='Country&apos;s Shop' datatype='string' name='[Country (DIM_FLOWERSHOPS)]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='string' name='[Country]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
            <column datatype='string' name='[Email (DIM_CUSTOMERS)]' role='dimension' type='nominal' />
            <column datatype='string' name='[Email]' role='dimension' type='nominal' />
            <column datatype='string' name='[Gender]' role='dimension' type='nominal' />
