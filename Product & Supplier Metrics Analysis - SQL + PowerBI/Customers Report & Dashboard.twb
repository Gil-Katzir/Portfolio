        <calculation class='tableau' formula='CASE [point]&#10;WHEN 1 THEN 0&#10;WHEN 2 THEN MIN({[Calculation_5199124304008343590]}/[Parameters].[Parameter 9]/[Parameters].[Parameter 8],1)&#10;END * PI()' />
      </column>
      <column caption='Gauge Point' datatype='spatial' name='[Calculation_5199124303994183706]' role='measure' type='nominal'>
        <calculation class='tableau' formula='MAKEPOINT(&#10;  [Point Radius (copy)_5199124303993704473]*SIN([Calculation_5199124303992758296]),&#10; -[Point Radius (copy)_5199124303993704473]*COS([Calculation_5199124303992758296])&#10;)' />
      </column>
      <column caption='Point Size' datatype='real' name='[Calculation_5199124303994613787]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [point]&#10;WHEN 1 THEN 10&#10;WHEN 2 THEN .2&#10;END' />
      </column>
      <column caption='Labels' datatype='spatial' name='[Calculation_5199124304006860834]' role='measure' type='nominal'>
        <calculation class='tableau' formula='MAKEPOINT(&#10;    [Point radius (copy)_5199124304002232351]*SIN([Point degrees (copy)_5199124304002232349]),&#10;    -([Point radius (copy)_5199124304002232351] - .05)*COS([Point degrees (copy)_5199124304002232349])&#10;)' />
      </column>
      <column caption='Labels %' datatype='real' default-format='p0%' name='[Calculation_5199124304007544868]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [point]&#10;WHEN 1 THEN [Parameters].[Parameter 5]&#10;WHEN 2 THEN [Parameters].[Parameter 6]   &#10;WHEN 3 THEN [Parameters].[Parameter 7]&#10;WHEN 4 THEN 1&#10;WHEN 5 THEN [Parameters].[Parameter 8]&#10;WHEN 6 THEN 0&#10;END' />
      </column>
      <column caption='Key Metric' datatype='real' name='[Calculation_5199124304008343590]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SUM([Sales])' />
      </column>
      <column caption='KPI' datatype='spatial' name='[Calculation_5199124304011755559]' role='measure' type='nominal'>
        <calculation class='tableau' formula='MAKEPOINT(-.2, 0)' />
      </column>
      <column datatype='string' name='[City]' role='dimension' semantic-role='[City].[Name]' type='nominal' />
      <column datatype='string' name='[Country/Region]' role='dimension' semantic-role='[Country].[ISO3166_2]' type='nominal' />
      <column datatype='string' hidden='true' name='[Customer ID]' role='dimension' type='nominal' />
      <column datatype='string' name='[Customer Name]' role='dimension' type='nominal' />
      <column caption='Labels Key Metric' datatype='real' default-format='c&quot;$&quot;#,##0,,.0M;(&quot;$&quot;#,##0,,.0M)' name='[Labels % (copy)_5199124304008265765]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [point]&#10;WHEN 1 THEN [Parameters].[Parameter 5]&#10;WHEN 2 THEN [Parameters].[Parameter 6]   &#10;WHEN 3 THEN [Parameters].[Parameter 7]&#10;WHEN 4 THEN 1&#10;WHEN 5 THEN [Parameters].[Parameter 8]&#10;WHEN 6 THEN 0&#10;END * [Parameters].[Parameter 9]' />
      </column>
      <column caption='KPI Name' datatype='spatial' name='[Metric Name (copy)_5199124304012046376]' role='measure' type='nominal'>
        <calculation class='tableau' formula='MAKEPOINT(1.1, 0)' />
      </column>
      <column caption='Point Radius' datatype='real' name='[Point Radius (copy)_5199124303993704473]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [point]&#10;WHEN 1 THEN 0&#10;WHEN 2 THEN 1 - [Parameters].[Parameter 3]/2&#10;END' />
      </column>
      <column caption='Labels Degrees' datatype='real' name='[Point degrees (copy)_5199124304002232349]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [point]&#10;WHEN 1 THEN [Parameters].[Parameter 5]&#10;WHEN 2 THEN [Parameters].[Parameter 6]&#10;WHEN 3 THEN [Parameters].[Parameter 7]&#10;WHEN 4 THEN 1&#10;WHEN 5 THEN [Parameters].[Parameter 8]&#10;WHEN 6 THEN 0&#10;END * PI()/[Parameters].[Parameter 8]' />
      </column>
      <column caption='Labels Radius' datatype='real' name='[Point radius (copy)_5199124304002232351]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='CASE [point]&#10;WHEN IN(1, 2, 3, 4, 5, 6) THEN 1 - [Parameters].[Parameter 3] - .05 - [Parameters].[Parameter 12] - [Parameters].[Parameter 10]&#10;END' />
      </column>
